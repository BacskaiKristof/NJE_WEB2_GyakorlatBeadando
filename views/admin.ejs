<%- include("partials/header") %>
<%- include("partials/page-banner", { cim: "Admin oldal", alcim: "Csak admin felhasználónak." }) %>

<section class="padding-small">
  <div class="container">
    <h2 class="mb-4">Üdv, <%= user.username %>!</h2>
    <div class="row g-4 mb-4">
      <div class="col-md-4"><div class="admin-stat"><div class="stat-num"><%= stat.gep %></div><div class="stat-label">notebook az adatbázisban</div></div></div>
      <div class="col-md-4"><div class="admin-stat"><div class="stat-num"><%= stat.user %></div><div class="stat-label">regisztrált felhasználó</div></div></div>
      <div class="col-md-4"><div class="admin-stat"><div class="stat-num"><%= stat.uzenet %></div><div class="stat-label">beérkezett üzenet</div></div></div>
    </div>
    <div class="row g-4">
      <div class="col-md-6 col-lg-4">
        <a href="/crud" class="feature-card d-block h-100">
          <svg class="feature-icon"><use xlink:href="#gear"></use></svg>
          <h3 class="card-title text-uppercase">CRUD</h3>
          <p>Notebookok felvétele, módosítása, törlése.</p>
        </a>
      </div>
      <div class="col-md-6 col-lg-4">
        <a href="/crud/uj" class="feature-card d-block h-100">
          <svg class="feature-icon"><use xlink:href="#database"></use></svg>
          <h3 class="card-title text-uppercase">Új notebook</h3>
          <p>Új gép felvétele az adatbázisba.</p>
        </a>
      </div>
      <div class="col-md-6 col-lg-4">
        <a href="/uzenetek" class="feature-card d-block h-100">
          <svg class="feature-icon"><use xlink:href="#envelope"></use></svg>
          <h3 class="card-title text-uppercase">Üzenetek</h3>
          <p>A Kapcsolat űrlapon érkezett üzenetek.</p>
        </a>
      </div>
    </div>
  </div>
</section>

<%- include("partials/footer") %>
