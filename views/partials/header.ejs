    <header id="header" class="site-header position-fixed text-black bg-light">
      <nav id="header-nav" class="navbar navbar-expand-lg px-3">
        <div class="container-fluid">
          <a class="navbar-brand brand-text" href="/">Notebook<span>Shop</span></a>
          <button class="navbar-toggler d-flex d-lg-none order-3 p-2" type="button" data-bs-toggle="offcanvas" data-bs-target="#bdNavbar" aria-controls="bdNavbar" aria-expanded="false" aria-label="Menü">
            <svg class="navbar-icon"><use xlink:href="#navbar-icon"></use></svg>
          </button>
          <div class="offcanvas offcanvas-end" tabindex="-1" id="bdNavbar" aria-labelledby="bdNavbarOffcanvasLabel">
            <div class="offcanvas-header px-4 pb-0">
              <a class="navbar-brand brand-text" href="/">Notebook<span>Shop</span></a>
              <button type="button" class="btn-close btn-close-black" data-bs-dismiss="offcanvas" aria-label="Bezárás" data-bs-target="#bdNavbar"></button>
            </div>
            <div class="offcanvas-body">
              <ul id="navbar" class="navbar-nav text-uppercase justify-content-end align-items-center flex-grow-1 pe-3">
                <li class="nav-item"><a class="nav-link me-4 <%= isActive('/') %>" href="/">Főoldal</a></li>
                <li class="nav-item"><a class="nav-link me-4 <%= isActive('/adatbazis') %>" href="/adatbazis">Adatbázis</a></li>
                <li class="nav-item"><a class="nav-link me-4 <%= isActive('/kapcsolat') %>" href="/kapcsolat">Kapcsolat</a></li>
                <% if (user) { %>
                  <li class="nav-item"><a class="nav-link me-4 <%= isActive('/uzenetek') %>" href="/uzenetek">Üzenetek</a></li>
                  <li class="nav-item"><a class="nav-link me-4 <%= isActive('/diagram') %>" href="/diagram">Diagram</a></li>
                <% } %>
                <% if (user && user.role === "admin") { %>
                  <li class="nav-item"><a class="nav-link me-4 <%= isActive('/crud') %>" href="/crud">CRUD</a></li>
                <% } %>
                <% if (!user) { %>
                  <li class="nav-item"><a class="nav-link me-4 <%= isActive('/login') %>" href="/login">Bejelentkezés</a></li>
                  <li class="nav-item"><a class="nav-link me-4 <%= isActive('/register') %>" href="/register">Regisztráció</a></li>
                <% } else { %>
                  <li class="nav-item dropdown">
                    <a class="nav-link me-4 dropdown-toggle user-menu <%= isActive('/user', '/admin') %>" data-bs-toggle="dropdown" href="#" role="button" aria-expanded="false">
                      <svg class="user-icon"><use xlink:href="#user"></use></svg> <%= user.username %>
                    </a>
                    <ul class="dropdown-menu dropdown-menu-end">
                      <li><span class="dropdown-item-text small text-muted">Szerepkör: <%= roleLabel %></span></li>
                      <li><a href="/user" class="dropdown-item">Saját oldal</a></li>
                      <% if (user.role === "admin") { %><li><a href="/admin" class="dropdown-item">Admin oldal</a></li><% } %>
                      <li><hr class="dropdown-divider"></li>
                      <li><a href="/logout" class="dropdown-item">Kijelentkezés</a></li>
                    </ul>
                  </li>
                <% } %>
              </ul>
            </div>
          </div>
        </div>
      </nav>
    </header>

    <main class="page-content">
    <% if (message) { %>
      <div class="container flash-container">
        <div class="alert alert-<%= messageType %> alert-dismissible fade show message" role="alert">
          <%= message %>
          <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Bezárás"></button>
        </div>
      </div>
    <% } %>
